APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://knowledge:knowledge@localhost:5432/knowledge_db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
WORKSPACE_ROOT=./runtime
MAX_UPLOAD_MB=100
PARSER_PROVIDER=mineru
MINERU_COMMAND=mineru-kit
MINERU_TIER=standard
MINERU_TIMEOUT_SECONDS=1800
# 内置 Worker 默认单实例串行领取任务；多进程部署时依靠 PostgreSQL 行锁避免重复领取。
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_SECONDS=1
TASK_HEARTBEAT_SECONDS=10
TASK_STALE_SECONDS=60
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_evidence
QDRANT_TIMEOUT_SECONDS=30
RRF_K=60
# 生产环境可配置 BAAI/bge-reranker-v2-m3；留空时跳过 Cross-Encoder。
RERANKER_MODEL=
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=512
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
SEARCH_CANDIDATE_LIMIT=5000
MEDCPT_CACHE_DIR=./runtime/models/medcpt
MEDCPT_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
MEDCPT_ARTICLE_MODEL=ncbi/MedCPT-Article-Encoder
MEDCPT_DEVICE=auto
MEDCPT_BATCH_SIZE=8
# 启用后，所有 /api/v1 与 /mcp 请求都必须携带 X-API-Key 或 Bearer token。
AUTH_ENABLED=false
API_KEYS_JSON={}

