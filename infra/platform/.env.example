MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_ENCRYPTION_KEY=
MCP_SERVERS_JSON=[{"name":"knowledge-api","transport":"streamable-http","url":"http://knowledge-api:8001/mcp/","allowed_tools":["list_knowledge_bases","search_medical_knowledge","get_knowledge_chunk"]}]
MAX_TOOL_ROUNDS=8
EVALUATION_REQUEST_TIMEOUT_SECONDS=300
# Agent 默认检索的知识库 UUID；也可由每次 ChatRequest.collection_id 覆盖。
DEFAULT_KNOWLEDGE_BASE_ID=
EVALUATION_REQUEST_TIMEOUT_SECONDS=300
EVALUATION_STALE_SECONDS=900
EVALUATION_TASK_MAX_RETRIES=3
# 可选 Cross-Encoder，例如 BAAI/bge-reranker-v2-m3；首次启动会下载模型。
RERANKER_MODEL=
DAILY_REQUEST_QUOTA=100
AGENT_AUTH_ENABLED=false
# 示例：{"key-1":{"user_id":"doctor-a","role":"editor"}}
AGENT_API_KEYS_JSON={}

