APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_db
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8080
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_MAX_TOKENS=4096
MODEL_TEMPERATURE=0.2
# 正式环境请设置稳定的随机字符串；留空时会在 WORKSPACE_ROOT 生成本机密钥。
MODEL_ENCRYPTION_KEY=
HARNESS_PROVIDER=deepseek-official
DSH_HOME=./runtime/dsh_home
MODEL_PROFILES_JSON={}
DEFAULT_MODEL_PROFILE=default
MCP_SERVERS_JSON=[{"name":"knowledge-api","transport":"streamable-http","url":"http://localhost:8001/mcp/","allowed_tools":["list_knowledge_bases","search_medical_knowledge","get_knowledge_chunk"]}]
MAX_HISTORY_TURNS=20
CONVERSATION_TTL_HOURS=24
WORKSPACE_ROOT=./runtime
REQUEST_TIMEOUT_SECONDS=120
MAX_TOOL_ROUNDS=8
DEFAULT_KNOWLEDGE_BASE_ID=
RETRIEVAL_TOP_K=8
DAILY_REQUEST_QUOTA=100
# 启用后 /api/v1 需要 API Key；键值映射到 user_id 与 viewer/reviewer/editor/admin。
AUTH_ENABLED=false
API_KEYS_JSON={}

